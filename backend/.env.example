# No credentials are included. Supply real values through the local environment or a secret store.
API_KEY=
WEB_CONCURRENCY=1
# For access-key credentials, uncomment and fill these values. Or use a named
# AWS profile by setting AWS_PROFILE in your shell. Do not configure both paths.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=work-bedrock
AWS_REGION=ap-south-1
S3_BUCKET=
DATABASE_URL=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=qwen.qwen3-32b-v1:0
BEDROCK_THINKING_MODEL_ID=openai.gpt-oss-20b-1:0
BEDROCK_RERANKER_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_RERANKER_REGION=us-east-1
EVIDENCE_MIN_COSINE_SIMILARITY=0.55
ENABLE_RERANKER=false
