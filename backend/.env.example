# Copy to .env and set real values locally. Never commit .env.
API_KEY=change-this-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/document_db

# Optional: set AWS_PROFILE=work-bedrock in your shell before starting the API.
AWS_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=qwen.qwen3-32b-v1:0
BEDROCK_THINKING_MODEL_ID=openai.gpt-oss-20b-1:0

VECTOR_COLLECTION=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
